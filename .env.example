# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env file to GitHub.

# MongoDB Atlas connection string (from Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/?retryWrites=true&w=majority

# Database and collection names
MONGODB_DB_NAME=amazon_product_project
MONGODB_COLLECTION=products

# Seconds to wait between web requests (be polite to the website)
REQUEST_DELAY_SECONDS=2
